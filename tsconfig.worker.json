{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@packages/*": ["packages/*"],
      "@frigo/domain": ["packages/domain/src/index.ts"],
      "@frigo/recipes": ["packages/recipes/src/index.ts"],
      "@frigo/ai": ["packages/ai/src/index.ts"],
      "@frigo/db": ["packages/db/src/index.ts"]
    }
  },
  "include": [
    "src/worker",
    "src/shared",
    "packages"
  ]
}
